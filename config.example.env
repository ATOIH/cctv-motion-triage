# config.example.env — copy to config.env and edit. config.env is gitignored.

# ---- paths ------------------------------------------------------------
SRC="/Volumes/YOUR_DRIVE/MIJIA_RECORD_VIDEO"   # archive root, holds YYYYMMDDHH folders
OUT="/Volumes/YOUR_DRIVE/gullak-out"           # daily/, digest/, collage/ created here
JOBS=8                                          # parallel ffprobe workers

# ---- detection --------------------------------------------------------
# Read docs/TUNING.md before changing these. Order of leverage:
# ROI first, then MIN_HITS, then the thresholds.
SCENE_HI=0.015          # score that OPENS a motion event
SCENE_LO=0.008          # score that SUSTAINS one. Keep near half of SCENE_HI
DETECT_WIDTH=480        # analysis width in px. Smaller is faster and less noisy
BLUR=1.2                # gaussian sigma before differencing
ROI=""                  # w:h:x:y. Empty = whole frame. Highest-leverage setting
MIN_HITS=1              # keyframes an event must span. 2+ kills insects and rain
YAVG_MAX_DELTA=12       # mean-luma jump treated as a lighting change. 999 disables
EVENT_GAP=30            # seconds of quiet that closes an event

# ---- render -----------------------------------------------------------
DIGEST_WIDTH=960        # width of the motion reel
DIGEST_FPS=6            # playback rate of the reel
DIGEST_CRF=21           # x264 quality, lower is better
KEEP_AUDIO=0            # 1 to carry audio through the merge
COLLAGE_COLS=6
COLLAGE_ROWS=5
COLLAGE_TILE_W=320
